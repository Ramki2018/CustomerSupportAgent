# Copy this file to .env and fill in values as needed.
# Leave OPENAI_API_KEY blank to run fully offline with the deterministic MockLLM (default).
# To enable OpenAI, set `OPENAI_API_KEY` and set `USE_MOCK_LLM=false`.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# Set to false to use OpenAI (requires OPENAI_API_KEY). Defaults to true when key is absent.
USE_MOCK_LLM=true

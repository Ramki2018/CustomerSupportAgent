OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
USE_MOCK_LLM=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_support_policies
QDRANT_LOCAL_PATH=.qdrant
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LangSmith tracing (optional, off by default). Traces contain only PII-sanitized text.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-support-agent

# API authentication for /chat and /feedback (send as the X-API-Key header). Leave blank for local development only;
# with APP_ENV=production a blank key makes the endpoints refuse all requests. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
